{
  "expo": {
    "name": "Pazimo Organizer",
    "slug": "pazimo-organizer-mobile",
    "scheme": "pazimoorganizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pazimo.organizer"
    },
    "android": {
      "package": "com.pazimo.organizer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Pazimo needs camera access so you can scan ticket QR codes at the door."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
