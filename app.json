{
  "expo": {
    "name": "Pazimo Organizer",
    "slug": "pazimo-organizer-mobile",
    "scheme": "pazimoorganizer",
    "version": "2.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.pazimoOrganizer",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleName": "Pazimo Organizer",
        "CFBundleDisplayName": "Pazimo Organizer",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pazimo.organizer",
      "adaptiveIcon": {
        "backgroundColor": "#121C32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Pazimo needs camera access so you can scan ticket QR codes at the door."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pazimo needs access to your photos so you can set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/partners-logo-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/partners-logo-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff570a9b-02ec-4722-b416-858b457681cc"
      }
    }
  }
}
