# Base URL of the Pazimo backend API, including the /api prefix.
# Local backend (adb reverse tcp:5000 tcp:5000, or your machine's LAN IP for a physical device):
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Production:
# EXPO_PUBLIC_API_URL=https://api.pazimo.com/api

# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are
# readable by anyone with the app installed — never put secrets here.
